#!/usr/bin/env bash
# partyos-blob-meta - client-side blob metadata helper.
#
# The client reads blob metadata from the catalog (server/games/catalog.json); each blob ALSO carries an embedded game.meta so it is
# self-describing once mounted. This tool parses both and answers the questions
# that other tools ask: app-store (list + categorise blobs), eviction (does a blob
# fit in remaining RAM?). It is a CLI BACKEND a GUI launcher can shell out to, so
# the behaviour is testable headlessly (no GUI clicks needed).
#
# It parses with grep/sed only (no jq - not in the base image). The catalog is
# generated by build-game-blobs.sh with one field per line, so a line-oriented
# parse is reliable.
#
# Subcommands:
#   list CATALOG
#       Print one TSV row per blob: id name version category size ram_min ram_max
#   field CATALOG NAME KEY
#       Print a single metadata KEY (id|version|category|size|ram_min|ram_max|
#       title|blob|sha256|marker|entry) for blob NAME from the catalog.
#   meta-of BLOBMETA KEY
#       Print KEY from a blob's EMBEDDED game.meta file (the self-describing copy).
#   fits CATALOG NAME FREE_MB
#       Exit 0 if the blob's ram_min <= FREE_MB (it can start), else exit 1.
#       Prints "fit name=<n> ram_min=<m> ram_max=<x> free=<f> verdict=<ok|nofit>".
#   need CATALOG NAME FREE_MB
#       Print how many MB short of ram_max the blob is given FREE_MB free
#       (0 if it already fits ram_max) - informs the eviction prompt.
#
# Exit codes: 0 ok / fits, 1 nofit (fits), 2 usage/parse error.
set -uo pipefail

usage() { echo "usage: partyos-blob-meta {list|field|meta-of|fits|need} ..." >&2; exit 2; }

# _block CATALOG NAME -> the JSON object lines for the entry whose "name" is NAME.
# The catalog has one field per line, so we walk it and capture the brace block
# that contains "name": "NAME".
_block() {
    local catalog="$1" name="$2"
    awk -v want="${name}" '
        /\{/ { buf=""; inb=1 }
        inb { buf = buf $0 "\n" }
        /"name":[[:space:]]*"/ {
            line=$0; sub(/.*"name":[[:space:]]*"/,"",line); sub(/".*/,"",line); cur=line
        }
        /\}/ {
            if (inb && cur==want) { printf "%s", buf; exit }
            inb=0
        }
    ' "${catalog}"
}

# _val JSONBLOCK KEY -> the value of "KEY" from a JSON block (string or number).
_val() {
    local block="$1" key="$2"
    printf '%s\n' "${block}" \
      | grep -oE "\"${key}\":[[:space:]]*(\"[^\"]*\"|[0-9]+)" \
      | head -1 \
      | sed -E "s/\"${key}\":[[:space:]]*//; s/^\"//; s/\"$//"
}

cmd_list() {
    local catalog="${1:?catalog}"
    [ -s "${catalog}" ] || { echo "partyos-blob-meta: catalog not found: ${catalog}" >&2; exit 2; }
    local names
    mapfile -t names < <(grep -oE '"name":[[:space:]]*"[^"]*"' "${catalog}" \
        | sed -E 's/.*"name":[[:space:]]*"([^"]*)".*/\1/')
    local n
    for n in "${names[@]}"; do
        local b; b="$(_block "${catalog}" "${n}")"
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$(_val "${b}" id)" "${n}" "$(_val "${b}" version)" \
            "$(_val "${b}" category)" "$(_val "${b}" size)" \
            "$(_val "${b}" ram_min)" "$(_val "${b}" ram_max)"
    done
}

cmd_field() {
    local catalog="${1:?catalog}" name="${2:?name}" key="${3:?key}"
    local b; b="$(_block "${catalog}" "${name}")"
    [ -n "${b}" ] || { echo "partyos-blob-meta: no entry name=${name}" >&2; exit 2; }
    local v; v="$(_val "${b}" "${key}")"
    [ -n "${v}" ] || { echo "partyos-blob-meta: no key=${key} for name=${name}" >&2; exit 2; }
    printf '%s\n' "${v}"
}

# meta-of parses a blob's EMBEDDED game.meta (KEY=value, parsed never sourced).
cmd_meta_of() {
    local metafile="${1:?game.meta path}" key="${2:?key}"
    [ -s "${metafile}" ] || { echo "partyos-blob-meta: meta not found: ${metafile}" >&2; exit 2; }
    local v
    v="$(grep -E "^${key}=" "${metafile}" | tail -1 | cut -d= -f2-)"
    [ -n "${v}" ] || { echo "partyos-blob-meta: no key=${key} in ${metafile}" >&2; exit 2; }
    printf '%s\n' "${v}"
}

cmd_fits() {
    local catalog="${1:?catalog}" name="${2:?name}" free="${3:?free_mb}"
    local b; b="$(_block "${catalog}" "${name}")"
    [ -n "${b}" ] || { echo "partyos-blob-meta: no entry name=${name}" >&2; exit 2; }
    local rmin rmax; rmin="$(_val "${b}" ram_min)"; rmax="$(_val "${b}" ram_max)"
    : "${rmin:=0}"; : "${rmax:=0}"
    local verdict rc
    if [ "${free}" -ge "${rmin}" ]; then verdict=ok; rc=0; else verdict=nofit; rc=1; fi
    echo "fit name=${name} ram_min=${rmin} ram_max=${rmax} free=${free} verdict=${verdict}"
    return "${rc}"
}

cmd_need() {
    local catalog="${1:?catalog}" name="${2:?name}" free="${3:?free_mb}"
    local b; b="$(_block "${catalog}" "${name}")"
    [ -n "${b}" ] || { echo "partyos-blob-meta: no entry name=${name}" >&2; exit 2; }
    local rmax; rmax="$(_val "${b}" ram_max)"; : "${rmax:=0}"
    local need=$(( rmax - free )); [ "${need}" -lt 0 ] && need=0
    echo "${need}"
}

[ $# -ge 1 ] || usage
sub="$1"; shift
case "${sub}" in
    list)    cmd_list    "$@";;
    field)   cmd_field   "$@";;
    meta-of) cmd_meta_of "$@";;
    fits)    cmd_fits    "$@";;
    need)    cmd_need    "$@";;
    *)       usage;;
esac
