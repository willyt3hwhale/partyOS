#!ipxe
# partyOS Step 6 boot script (TEMPLATE) - hot-plug USB support.
# Rendered at serve time by scripts/vm/render-ipxe.sh ({{SERVER_URL}} ->
# harness SERVER_URL). Reached automatically via the DHCP boot filename, same as
# Steps 1-5 (no typed iPXE command).
#
# Boots the SAME custom XFCE image as Steps 3/4/5 (server/images/custom/, which
# has the 'gamer' user + rsync), with the SAME kernel/initramfs Step 2 RAM-boots.
# The only difference from Step 5 is the fetched automated-script: step6-script.sh,
# which adds udev rules detecting USB removal/insertion, pause/resume of the
# RAM->USB sync, and USB-status notifications on top of the Step 5 sync timer.

echo ================================================
echo partyOS Step 6 - Hot-Plug USB Support
echo ================================================
echo IP Address: ${ip}
echo Server URL: {{SERVER_URL}}
echo PARTYOS-NETBOOT-OK
imgfetch {{SERVER_URL}}/report?step=6&status=boot&ip=${ip} r6 || echo callback-skipped
imgfree r6 || echo continuing

echo Loading custom desktop image into RAM (Step 6 hot-plug)...
# archiso_http_srv -> the custom image dir (arch/x86_64/airootfs.sfs); copytoram
# pulls the whole sfs into RAM. console=ttyS0 mirrors to the serial line the
# harness scrapes. no_timer_check: QEMU q35+TCG timer-routing quirk. report_url=
# is read by step6-script.sh for its HTTP callback (no hardcoded IP).
kernel {{SERVER_URL}}/server/images/vmlinuz-linux initrd=initramfs-linux.img archisobasedir=arch archiso_http_srv={{SERVER_URL}}/server/images/custom/ ip=dhcp copytoram cow_spacesize=4G no_timer_check console=tty0 console=ttyS0,115200 script={{SERVER_URL}}/boot/step6-script.sh report_url={{SERVER_URL}} || goto failed

echo Downloading initramfs...
initrd {{SERVER_URL}}/server/images/initramfs-linux.img || goto failed

echo Starting partyOS (hot-plug USB support)...
boot || goto failed

:failed
echo partyOS Step 6 boot failed
