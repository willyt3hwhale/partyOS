  <p class="foot">partyOS - PXE-booted from RAM - {{PXE_URL}}<br>
  made with love &amp; spite by LilWil</p>

  <script>
  // Easter egg: Konami code (up up down down left right left right B A) -> PARTY MODE.
  (function(){
    var seq=[38,38,40,40,37,39,37,39,66,65], pos=0;
    document.addEventListener('keydown', function(e){
      pos = (e.keyCode === seq[pos]) ? pos+1 : 0;
      if (pos === seq.length){
        pos = 0;
        var on=true, n=0, iv=setInterval(function(){
          document.body.style.filter = on ? 'hue-rotate(180deg) saturate(3)' : '';
          on=!on; if(++n>12){clearInterval(iv); document.body.style.filter='';}
        }, 180);
        alert('PARTY MODE UNLOCKED!\n\npartyOS by LilWil. You found the secret.\nTouch grass... after the LAN.');
      }
    });
  })();
