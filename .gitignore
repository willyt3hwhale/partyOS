# Large, regenerable boot/image assets - never commit (~2GB)
arch/
server/images/
*.sfs
*.img
*.qcow2
*.iso
*.usb
*.efi
build/*.usb

# In-session player issue reports (POSTed to /feedback by partyos-report) - local
# operator data, one timestamped JSON each; reviewed after the event, never committed.
server/reports/

# Per-run output of the app launch harness (scripts/test/test-apps.sh): timestamped
# dirs with per-app logs, screenshots and summary.{json,md}. Local test evidence,
# regenerable, not for git.
scripts/test/results/

# Rendered-at-deploy portal page (generated from portal/index.html.tmpl)
portal/index.html

# Generated game blobs + catalog (built by scripts/build/build-game-blobs.sh)
server/games/*.squashfs
server/games/*.squashfs.sha256
server/games/catalog.json

# Rendered-at-serve-time iPXE scripts (generated from *.ipxe.tmpl)
boot/partyos*.ipxe
boot/partyos.ipxe.vm

# VM harness scratch artifacts
*.serial
*.qmp
*.pid

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Build output of the patched Thunar package
scripts/build/thunar-patched/

# Generated blob torrents (regenerated by gen-blob-torrents.sh / at deploy)
server/games/*.squashfs.torrent

# LAN mirror package binaries - large, regenerable via mirror-pkgs.sh, not for git.
# [partyos] (stock, signed) + [partyos-local] (custom unsigned, e.g. thunar-patched).
server/lanmirror/
server/lanmirror-local/

# TLS / private CA (HTTPS boot chain, scripts/deploy/gen-ca.sh).
# SECRETS - never commit private keys. The CA key signs every leaf; the leaf key
# is the server's identity. Both are regenerable via gen-ca.sh.
ca/*.key
# openssl's CA serial state file - regenerable bookkeeping, not for git.
ca/*.srl
# The CA cert is not committed: each clone mints its own (setup.sh / gen-ca.sh). See ca/README.md.
ca/*.crt
# install-certs.sh keeps the displaced self-minted CA material next to it for --restore-lab.
ca/*.lab-backup
ca/EXTERNAL-CA
# The server leaf cert+key are regenerated per host and not shared - ignore the
# whole dir. The server runs HTTP-only (with a warning) if these are absent.
server/tls/
# Keep ca/README.md, which explains why the rest of ca/ is ignored.
!ca/README.md

# contributor blob deliverables (large squashfs) - never commit
blob-out/

# Per-player provisioning config store (scripts/deploy/gen-user-config.sh +
# flash-usb.sh --user). Real player names + pinned static IPs are per-deployment
# operator data, NOT for git. Keep only the committed users/README.md + the
# users/example/ template so the format/scheme stays documented and versioned.
users/*
!users/README.md
!users/example/
!users/example/**

# Local fleet table for fleet-verify.sh
scripts/deploy/fleet.conf

# Backups that setup.sh and prepare-event.sh write next to deploy.conf
deploy.conf.bak.*

# Local ssh key baked into the image, not part of the project
scripts/build/files/rootfs/root/.ssh/authorized_keys

issues/

# Generated by setup.sh with the venue server name
build/embed-https.ipxe

# Runtime announcement feed written by announce.sh
server/notices.json

# The local deploy config. setup.sh creates it from deploy.conf.tmpl.
deploy.conf
